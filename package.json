{
  "name": "ttr-reference",
  "version": "0.0.1",
  "private": true,
  "description": "Toontown Rewritten calculators, mechanics, and strategy references",
  "type": "module",
  "homepage": "https://kjclemente.github.io/ttr-reference/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjclemente/ttr-reference.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"**/*.{css,astro}\" --max-warnings 0",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0"
  }
}
